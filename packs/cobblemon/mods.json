  "keybinds": [
    {
      "key": "key_iris.keybind.reload",
      "from": "key.keyboard.r",
      "to": "key.keyboard.unknown",
      "why": "R is Cobblemon's 'throw Pokémon'; Iris's reload-shaders on R froze the game on every throw"
    },
    {
      "key": "key_iris.keybind.shaderPackSelection",
      "from": "key.keyboard.o",
      "to": "key.keyboard.unknown",
      "why": "O is Cobblemon's 'hide party'; the shader menu is still in Options > Video Settings > Shader Packs"
    },
    {
      "key": "key_key.travelersbackpack.inventory",
      "from": "key.keyboard.b",
      "to": "key.keyboard.g",
      "why": "B is Xaero's 'new waypoint'; G is free in this profile"
    },
    {
      "key": "key_key.travelersbackpack.cycle_tool",
      "from": "key.keyboard.z",
      "to": "key.keyboard.h",
      "why": "Z is Xaero's 'enlarge minimap'; H is free in this profile"
    },
    {
      "key": "key_key.ricksportalgun.portal_menu",
      "from": "key.keyboard.v",
      "to": "key.keyboard.j",
      "why": "V is this profile's camera-view key; J is free"
    },
    {
      "key": "key_key.autoswitch.toggle",
      "from": "key.keyboard.r",
      "to": "key.keyboard.n",
      "why": "R is Cobblemon's throw Pokémon and Iris's reload; N is free in both profiles"
    },
    {
      "key": "key_zoomify.key.zoom.secondary",
      "from": "key.keyboard.f6",
      "to": "key.keyboard.unknown",
      "why": "F6 is First-person Model's toggle; Zoomify's secondary (cinematic) zoom is left unbound"
    }
  ],
  "config_fixes": [
    {
      "file": "config/roughlyenoughitems/config.json5",
      "find": "(\"recipeKeybind\"\\s*:\\s*\\{\\s*\"keyCode\"\\s*:\\s*)\"key\\.keyboard\\.r\"",
      "replace": "${1}\"key.keyboard.y\"",
      "why": "REI's 'show recipe' on R also triggered Inventory Profiles Next's sort; recipe moves to Y, next to REI's U for uses"
    },
    {
      "file": "config/autoswitchUseAction.cfg",
      "find": "(?m)^(minecraft!creeper[ \\t]*=[ \\t]*)minecraft:flint_and_steel(?=\\r?$)",
      "replace": "${1}",
      "why": "AutoSwitch swapped to flint and steel when right-clicking a creeper, which lights it"
    }
  ]
